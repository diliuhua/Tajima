<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.0.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================================</c>
<c>* 卷尺瑕疵检测补丁脚本 —— 场景 1</c>
<c>* 目标：白色/黄色【背景区域】上的【浅色划痕 / 脏污】</c>
<c>*       特征：与背景颜色差异很小(低对比度)、面积较小，AI 异常检测易漏检</c>
<c>* 方法：背景光照估计(mean_image) + 动态阈值(dyn_threshold)</c>
<c>*       不看绝对灰度，只看相对局部背景的偏差，适合低对比度小缺陷</c>
<c>* 用法：HDevelop 打开本文件，按 F5 运行；将 ImageFile 改为你的图像路径</c>
<c>* ============================================================================</c>
<c></c>
<c>* ---- 0. 可调参数区(按真实图像微调) ----</c>
<c>* 待检图像路径</c>
<l>ImageFile := '1_4_20260529_134337.jpg'</l>
<c>* 背景(白/黄)最低灰度，把背景从黑色刻度/数字中分出。白约255, 黄约200</c>
<l>BackgroundMinGray := 150</l>
<c>* 认定为背景大块的最小面积，用来剔除孤立亮噪点</c>
<l>BGAreaMin := 3000</l>
<c>* 背景ROI向内收缩半径，避开刻度线/数字/边框边缘。边缘误检多就调大</c>
<l>ErodeBGRadius := 6</l>
<c>* 背景光照估计的均值滤波核(必须奇数)。划痕越宽或背景越不均匀就调大</c>
<l>SmoothSize := 41</l>
<c>* 比局部背景暗超过该灰度判为脏污/偏暗划痕。越小越灵敏；漏检降到4~5,噪点多升到8~10</c>
<l>OffsetDark := 6</l>
<c>* 比局部背景亮超过该灰度判为偏亮划痕。越小越灵敏</c>
<l>OffsetLight := 6</l>
<c>* 闭运算半径，连接断开的划痕段。划痕断续严重就调大</c>
<l>CloseRadius := 2</l>
<c>* 最小缺陷面积(像素)，过滤噪点</c>
<l>MinDefectArea := 8</l>
<c>* 最大缺陷面积(像素)，过大的交给已有AI异常检测</c>
<l>MaxDefectArea := 5000</l>
<c></c>
<c>* ---- 1. 读图转灰度 ----</c>
<l>read_image (Image, ImageFile)</l>
<l>count_channels (Image, Channels)</l>
<l>if (Channels &gt;= 3)</l>
<l>    rgb1_to_gray (Image, GrayImage)</l>
<l>else</l>
<l>    copy_image (Image, GrayImage)</l>
<l>endif</l>
<l>get_image_size (GrayImage, Width, Height)</l>
<c></c>
<c>* ---- 2. 分离白/黄背景，排除黑色刻度/数字/边框 ----</c>
<l>threshold (GrayImage, BrightRegion, BackgroundMinGray, 255)</l>
<l>fill_up (BrightRegion, BrightFilled)</l>
<l>connection (BrightFilled, BrightConn)</l>
<l>select_shape (BrightConn, BGLarge, 'area', 'and', BGAreaMin, 99999999)</l>
<l>union1 (BGLarge, BGUnion)</l>
<l>erosion_circle (BrightRegion, BGCore, ErodeBGRadius)</l>
<l>intersection (BGCore, BGUnion, BGRoi)</l>
<c></c>
<c>* ---- 3. 背景估计 + 动态阈值(核心：抓低对比度小缺陷) ----</c>
<l>reduce_domain (GrayImage, BGRoi, ImageRoi)</l>
<l>mean_image (ImageRoi, ImageMean, SmoothSize, SmoothSize)</l>
<l>dyn_threshold (ImageRoi, ImageMean, RegDark, OffsetDark, 'dark')</l>
<l>dyn_threshold (ImageRoi, ImageMean, RegLight, OffsetLight, 'light')</l>
<l>union2 (RegDark, RegLight, RegDefectRaw)</l>
<c></c>
<c>* ---- 4. 清理 + 面积筛选(细划痕禁用开运算,否则会被腐蚀掉) ----</c>
<l>closing_circle (RegDefectRaw, RegClosed, CloseRadius)</l>
<l>connection (RegClosed, RegConn)</l>
<l>select_shape (RegConn, RegDefect, 'area', 'and', MinDefectArea, MaxDefectArea)</l>
<c></c>
<c>* ---- 5. 结果显示 + 缺陷信息输出 ----</c>
<l>dev_close_window ()</l>
<l>dev_open_window_fit_image (Image, 0, 0, -1, -1, WindowHandle)</l>
<l>dev_display (Image)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (2)</l>
<l>dev_set_color ('red')</l>
<l>dev_display (RegDefect)</l>
<l>count_obj (RegDefect, NumDefects)</l>
<c>* 逐个输出缺陷面积与中心坐标(DefRow/DefCol)，便于后续与AI结果合并</c>
<l>for i := 1 to NumDefects by 1</l>
<l>    select_obj (RegDefect, OneDefect, i)</l>
<l>    area_center (OneDefect, DefArea, DefRow, DefCol)</l>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
